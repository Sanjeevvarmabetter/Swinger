# ---- AI ----
# Get a key at https://aistudio.google.com/apikey  (never commit your real .env)
GEMINI_API_KEY=
# Any Gemini model id your key can access, e.g. gemini-3.8-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash
# Minimum seconds between Gemini calls (simple client-side rate limit)
GEMINI_MIN_INTERVAL_SECONDS=4
GEMINI_MAX_RETRIES=3

# ---- Data ----
# SEC EDGAR requires a descriptive User-Agent with contact info:
# e.g. "AI-Trading-OS your-name your-email@example.com". Leave blank to disable EDGAR.
SEC_USER_AGENT=
# Optional FRED St. Louis Fed API key (works via public CSV without a key)
FRED_API_KEY=
# Optional Finnhub API key for real-time quotes, news, and earnings calendars
FINNHUB_API_KEY=
# Optional Financial Modeling Prep (FMP) API key
FMP_API_KEY=

# ---- Storage ----
# Directory for SQLite databases, caches and backups (default: ./data)
TRADINGOS_DATA_DIR=
